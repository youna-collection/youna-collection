# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Données personnelles : ne jamais les envoyer sur GitHub
/data-privee/
*customers_export*.csv
*orders_export*.csv

# Supabase
/supabase/.temp/

# Photos téléchargées et optimisées par l'import du catalogue
/.cache/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local Netlify folder
.netlify

# Réglages locaux de Claude Code
/.claude/

# Codes de secours personnels : ne jamais publier
/stripe/
