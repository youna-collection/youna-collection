# Copier ce fichier sous le nom .env.local, puis remplir les valeurs.
# Ne jamais mettre de vraie clé dans ce fichier-ci : il est envoyé sur GitHub.

# --- Site ---
# En local : http://localhost:3000 ; sur Netlify : l'adresse du site.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (phase 1) : Project Settings > API Keys ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clé secrète : donne un accès total. Jamais de préfixe NEXT_PUBLIC_ ici.
SUPABASE_SECRET_KEY=

# Mettre true une fois la connexion Google configurée dans Supabase.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# --- Stripe (phase 3), clés de TEST jusqu'à la validation complète ---
STRIPE_SECRET_KEY=
# Secret du webhook (whsec_...), créé dans Stripe > Développeurs > Webhooks
# avec l'adresse https://<site>/api/stripe/webhook et les événements checkout.session.*
STRIPE_WEBHOOK_SECRET=
# Les clés live (vrais paiements) sont refusées tant que ceci n'est pas à true (lancement).
STRIPE_ALLOW_LIVE=false

# --- Mondial Relay (phase 3) : BDTEST pour les essais ---
NEXT_PUBLIC_MONDIAL_RELAY_BRAND=BDTEST

# --- Resend (phase 6) : resend.com > API Keys ---
RESEND_API_KEY=
# Expéditeur. Sans domaine vérifié chez Resend : Youna Collection <onboarding@resend.dev>
# (Resend n'envoie alors qu'à l'adresse du compte Resend). Au lancement : Youna Collection <contact@votre-domaine>.
EMAIL_FROM=
# Adresse de la boutique : reçoit les alertes et les réponses des clientes, et TOUS les e-mails en mode essai.
SHOP_EMAIL=
# Tant que ce n'est pas true, aucune cliente ne reçoit d'e-mail (tout part vers SHOP_EMAIL). true au lancement.
EMAIL_ALLOW_REAL=false
